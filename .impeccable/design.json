{
  "schemaVersion": 2,
  "world": "boarding-pass-and-gate-board",
  "mode": "operate",
  "buildPath": "code",
  "buildPathSource": "round-default",
  "version": 2,
  "craft": {
    "hero": ".impeccable/craft/boarding-hero.webp",
    "board": ".impeccable/craft/boarding-board.webp"
  },
  "tokens": {
    "color": {
      "ink": "#0B0D10",
      "slate": "#1C2127",
      "steel": "#6B7178",
      "panel": "#E6E8EB",
      "surface": "#FFFFFF",
      "ground": "#F2F3F5",
      "hairline": "#D8DADD",
      "alert": "#FFD400",
      "success": "#1B6E3C",
      "error": "#B3261E",
      "zone": {
        "home": "#0B0D10",
        "market": "#B45309",
        "course": "#1E4FA0",
        "canteen": "#C2410C",
        "teammate": "#0F766E",
        "share": "#6D28D9",
        "job": "#4D7C0F",
        "message": "#475569"
      }
    },
    "font": {
      "ui": "Inter",
      "mono": "IBM Plex Mono",
      "display": "Space Grotesk",
      "display-gate": "2.75-3rem/1.05 700",
      "heading-1": "1.75rem/1.2 600",
      "heading-2": "1.25rem/1.3 600",
      "heading-3": "1rem/1.4 600",
      "body-1": "0.9375rem/1.5",
      "body-2": "0.8125rem/1.45",
      "caption": "0.75rem/1.4",
      "mono-label": "0.6875rem/1.3 uppercase 0.08em (style B: all UI labels - buttons, nav, eyebrow, columns, field names)",
      "mono-data": "0.8125rem tabular"
    },
    "spacing": "4pt base: 1-2-3-4-6-8-12-16",
    "radius": {
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "board-row": "0"
    },
    "shadow": {
      "none": "none",
      "hairline": "no shadow, hairlines only",
      "surface": "1-layer soft",
      "elevate": "modal/dropdown"
    },
    "motion": {
      "ease": "cubic-bezier(0.2,0,0.3,1)",
      "feedback": "120-200ms",
      "rerank": "260-320ms",
      "signature": "row identity rerank in place; change row holds alert until noticed"
    },
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    }
  },
  "open-decisions": [
    "dark-mode: deferred, not default",
    "brand-assets: placeholder until user supplies logo/campus imagery",
    "resolved: module zone colors (Option 1, fixed per-module identity colors; alert remains the only change signal)"
  ]
}
