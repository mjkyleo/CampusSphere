# ============================================================================
# 邮箱验证码集成示例（Flask）环境变量
# 复制为 .env 后填写真实值：cp .env.example .env
# 由 python-dotenv 的 load_dotenv() 加载到环境变量
# ============================================================================

# ----- 主 SMTP（校园邮箱服务商，如腾讯企业邮 / 阿里邮箱）-----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@school.edu.cn
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@school.edu.cn

# ----- 备用 SMTP（QQ 个人邮箱，主邮箱连续失败达到阈值时切换）-----
# 注意：QQ 邮箱需用「授权码」而非登录密码
BACKUP_SMTP_HOST=smtp.qq.com
BACKUP_SMTP_PORT=465
BACKUP_SMTP_USER=backup@qq.com
BACKUP_SMTP_PASS=your-qq-authorization-code
BACKUP_SMTP_FROM=backup@qq.com

# ----- Redis（存储验证码，5 分钟过期）-----
REDIS_URL=redis://localhost:6379/0

# ----- 管理员告警邮箱（主备切换时通知）-----
ADMIN_ALERT_EMAIL=admin@school.edu.cn

# ----- 发送频率控制（每封间隔秒数 / 每小时上限）-----
SEND_MIN_INTERVAL=30
SEND_MAX_PER_HOUR=50

# ----- 主备切换阈值（连续失败次数达到后切换）-----
SMTP_FAILOVER_THRESHOLD=3

# ----- Flask -----
FLASK_DEBUG=false
