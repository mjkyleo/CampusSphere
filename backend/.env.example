# ===== 应用基础 =====
APP_NAME=campus-life-platform
DEBUG=false

# ===== 数据库 =====
# 开发/测试零依赖：SQLite
DB_URL=sqlite+aiosqlite:///./dev.db
# 生产（PostgreSQL 16）：
# DB_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 安全 / JWT =====
SECRET_KEY=change-me-to-a-long-random-string-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=120

# ===== 管理员后台安全 =====
# 生产环境必须配置以下两项（否则启动期 validate_admin_security 会直接 SystemExit 拒绝启动）：
# - ADMIN_GATEWAY_KEY：管理端"网关密钥"，仅用于换取短时网关令牌，切勿写入前端源码；
#   通过安全渠道告知管理员。长度 >= 16，请勿使用下方占位值。
# - ADMIN_BOOTSTRAP_PASSWORD：首次启动自动创建的管理员密码，长度 >= 16。
# ADMIN_GATEWAY_ENFORCE 默认 true（强制校验 X-Admin-Gateway 头，隐藏 /api/admin/* 可达性）；
# 仅本地开发可临时置为 false。
ADMIN_GATEWAY_ENFORCE=true
ADMIN_GATEWAY_KEY=change-me-admin-gateway-key-16plus
ADMIN_BOOTSTRAP_USERNAME=siteadmin
ADMIN_BOOTSTRAP_PASSWORD=change-me-deploy-with-strong-pw-16plus
ADMIN_BOOTSTRAP_MIN_LENGTH=16
ADMIN_GATEWAY_ROTATE_SECONDS=3600

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","https://admin.example.edu.cn"]

# ===== 多校配置路径 =====
SCHOOL_CONFIG_PATH=../config/school.yaml

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=campus

# ===== Meilisearch 搜索 =====
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=masterKey

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 以下由 scripts/doc_sync.py --sync-env-example 自动补全（请勿手改此段）=====
# 常驻连接数
DB_POOL_SIZE=10
# 秒：回收空闲连接，规避中间件静默断连（如 PG 的 idle_timeout）
DB_POOL_RECYCLE=1800
# 秒：等待连接池可用的最大阻塞时间
DB_POOL_TIMEOUT=30
# 默认开启；测试/本地无 Redis 时自动降级为内存字典，不会阻断业务。 关闭：设置 CACHE_ENABLED=false（如离线单测避免跨用例污染）。
CACHE_ENABLED=true
# 热点列表缓存基础 TTL（秒）；实际写入会叠加随机抖动以规避雪崩（见 app/core/cache.py）。
CACHE_TTL_SECONDS=60
ADMIN_BOOTSTRAP_ENABLED=true
# 未配置 SMTP 时，验证码接口会返回 debug_code 便于测试联调； 配置后验证码仅通过邮件送达，生产环境必须配置。
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# 关闭后 /api/auth/send-code 不再要求票据（供测试与内网环境使用）。
CAPTCHA_ENABLED=true
# 缺口对齐容差（像素），过小会伤及真实用户体验
CAPTCHA_TOLERANCE_PX=6
# 滑块令牌有效期
CAPTCHA_TTL_SECONDS=300
# 同一滑块最多校验次数，超出即作废
CAPTCHA_MAX_ATTEMPTS=3
# 轨迹最少采样点，防脚本直传坐标
CAPTCHA_MIN_TRACK_POINTS=6
# 校验通过签发的票据有效期
CAPTCHA_TICKET_TTL_SECONDS=120
# 极验行为验证 4.0：留空则使用自建拼图滑块；填入 id+key 后自动切换到极验
GEETEST_CAPTCHA_ID=""
# 极验验证私钥，服务端二次校验签名用，切勿下发到前端
GEETEST_CAPTCHA_KEY=""
# 二次校验接口超时（秒）。必须设上限：极验不可达时若无限等待会拖死工作线程
GEETEST_TIMEOUT=5
# 极验服务不可达时是否放行：true=保证用户仍可注册（防刷能力降级）；false=拒绝注册
GEETEST_FAIL_OPEN=true
# 验证码有效期
CODE_TTL_SECONDS=300
# 同一验证码最多校验次数，超出即作废
CODE_MAX_ATTEMPTS=5
