# ===== 应用基础 =====
APP_NAME=campus-life-platform
DEBUG=false

# ===== 数据库 =====
# 开发/测试零依赖：SQLite
DB_URL=sqlite+aiosqlite:///./dev.db
# 生产（PostgreSQL 16）：
# DB_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 安全 / JWT =====
SECRET_KEY=change-me-to-a-long-random-string-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=120

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","https://admin.example.edu.cn"]

# ===== 多校配置路径 =====
SCHOOL_CONFIG_PATH=../config/school.yaml

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=campus

# ===== Meilisearch 搜索 =====
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=masterKey

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
