# ⚠️ 已废弃，请勿继续使用本文件
#
# Worker 镜像现由 **backend/Dockerfile 的 `worker` target** 构建：
#     docker build --target worker -t campusphere-worker:latest backend/
#     # 或 docker compose -f deploy/docker-compose.yml build worker
#
# 合并原因：app 与 worker 的编译依赖、venv、alembic、非 root 用户等 95% 内容完全相同，
# 拆成两份文件必然产生漂移（改一处忘另一处，导致"worker 缺依赖"只在生产暴露）。
#
# 本文件保留仅为兼容历史脚本/文档的引用，其内容已不再维护。
# 构建上下文需为 backend/：`docker build -f deploy/Dockerfile.worker backend`
#
# ---------------- 以下为历史内容 ----------------

# Celery Worker 镜像 —— 多阶段构建 + 非 root + 健康检查
#
# 阶段划分与后端一致：builder 编译依赖并打包 app，runtime 仅携带 venv 与 alembic 配置，
# 以非 root 用户运行。worker 依赖全部来自 pyproject 的运行时依赖（celery/redis/sqlalchemy/...），
# 因此同样用 `pip install .` 统一安装，保证与后端依赖单一可信源。

# ---------------- 构建阶段 ----------------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install .

# ---------------- 运行阶段 ----------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

USER appuser

# Worker 健康检查：向 Broker 探活自身（依赖 Redis 可达；不可达即判定不健康）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD celery -A app.tasks.celery_app.celery_app inspect ping || exit 1

# 启动 Celery Worker（邮件/通知/搜索同步队列）
CMD ["celery", "-A", "app.tasks.celery_app.celery_app", "worker", "--loglevel=info", "-Q", "email,notify,search,default"]
