# ===== 部署拓扑（可选）=====
# FRONTEND_DIST：前端产物输出到的**宿主机**目录。
#   拓扑 A（自带 nginx 容器）：留空，默认输出到 deploy/frontend-dist/
#   拓扑 B（外部 nginx 反代）：设为宿主机绝对路径，如 /www/wwwroot/campussphere
# FRONTEND_DIST=

# BASE_IMAGE：基础镜像。registry-1.docker.io 不可达时指向可用加速镜像，
# 例如 dockerproxy.net/library/python:3.12-slim。留空回退官方源。
# BASE_IMAGE=

# ============================================================================
# 部署环境模板 —— **仅供复制，不要直接用于部署**
#
# 正确用法：
#   cp deploy/.env.example deploy/.env   # 然后逐个替换下面所有 <...> 占位
#   docker compose -f deploy/docker-compose.yml up -d
#
# docker-compose.yml 的 env_file 指向 deploy/.env（不是本文件）。
# 若 .env 不存在 compose 会报错退出，防止误用本文件的占位值上线。
#
# 所有 <...> 形式的占位值在生产校验中会被拒绝启动：
#   - SECRET_KEY / MEILI_API_KEY / MINIO_* / ADMIN_GATEWAY_KEY 等不得为默认占位
#   - SMTP_HOST 必须配置，否则验证码无法送达，注册链路不可用
# ============================================================================

# ===== 应用基础 =====
APP_NAME=campus-life-platform
# 生产务必 false。true 时验证码会从接口响应回传（可用于本地联调）
DEBUG=false

# ===== 数据库 / 缓存 =====
DB_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
REDIS_URL=redis://redis:6379/0

# ===== 安全 / JWT =====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=120

# ===== CORS（填真实访问域名，移除 localhost 与 example 占位）=====
CORS_ORIGINS=["https://<YOUR_DOMAIN>"]

# ===== 多校配置 =====
SCHOOL_CONFIG_PATH=/app/config/school.yaml

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<GENERATE_RANDOM>
MINIO_SECRET_KEY=<GENERATE_RANDOM>
MINIO_SECURE=false
MINIO_BUCKET=campus

# ===== Meilisearch 搜索 =====
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=<GENERATE_RANDOM>

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== 邮件发送（验证码 / 通知）—— 生产必须配置 =====
# 未配置时：DEBUG=false 下验证码既不发送也不回传，注册链路直接不可用，
#           且应用启动校验会拒绝启动（避免带病上线）。
# 465 = SSL 直连；587 等端口自动走 STARTTLS。可用 SMTP_STARTTLS 强制覆盖。
# 密码若含 # 等特殊字符，必须加双引号，否则会被当作注释起始而截断。
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=465
SMTP_USER=<SMTP_USERNAME>
SMTP_PASS="<SMTP_PASSWORD>"
# 留空则回退为 SMTP_USER（多数服务商要求两者一致）
SMTP_FROM=
SMTP_TIMEOUT=10
# 是否在 send-code 响应里回传验证码。**生产必须为 false**：
# true 会让任何人都能读到 6 位验证码，无需拥有邮箱即可注册/改密。
EXPOSE_VERIFICATION_CODE=false

# ===== 管理员后台安全 =====
# 生产必须 true；false 会跳过网关密钥校验并触发告警
ADMIN_GATEWAY_ENFORCE=true
# 长度需 >= 16，且不得为 change-me 等占位值
ADMIN_GATEWAY_KEY=<GENERATE_RANDOM_16+>
ADMIN_GATEWAY_ROTATE_SECONDS=3600
ADMIN_BOOTSTRAP_USERNAME=siteadmin
ADMIN_BOOTSTRAP_PASSWORD=<GENERATE_RANDOM>
ADMIN_BOOTSTRAP_MIN_LENGTH=16

# ===== 可观测性 =====
# 留空则回退为控制台输出，不阻断启动
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=campus-life-platform
