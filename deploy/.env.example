# 部署环境模板（docker-compose 使用）
APP_NAME=campus-life-platform
DEBUG=false

DB_URL=postgresql+asyncpg://campus:campus@postgres:5432/campus
REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:5173","https://admin.example.edu.cn"]

SCHOOL_CONFIG_PATH=../config/school.yaml

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=campus

MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=masterKey

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
