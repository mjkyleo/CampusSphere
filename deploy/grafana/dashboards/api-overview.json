{
  "title": "Campus API Overview",
  "uid": "campus-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "HTTP 请求总量",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(campus_http_requests_total[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 2,
      "title": "请求延迟 P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(campus_http_request_latency_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "title": "状态码分布",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (status) (campus_http_requests_total)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
